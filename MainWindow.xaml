<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:StudentRegistrationApp.Converters"
        xmlns:viewmodels="clr-namespace:StudentRegistrationApp.ViewModels"
        mc:Ignorable="d"
        Title="SISMA - Student Registration App | Professional WPF Rich UI" 
        Height="800" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, Roboto, Helvetica, Arial">

    <Window.Resources>
        <!-- Converters -->
        <converters:EqualityToVisibilityConverter x:Key="EqToVis"/>
        <converters:EqualityToBooleanConverter x:Key="EqToBool"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Geometries for Vector Icons -->
        <Geometry x:Key="GradCapIconGeo">M12,3 L1,9 L12,15 L21,10.09 L21,17 L23,17 L23,9 L12,3 Z M5,13.18 L5,17.18 L12,21 L19,17.18 L19,13.18 L12,17 L5,13.18 Z</Geometry>
        <Geometry x:Key="DashboardIconGeo">M3,13 L11,13 L11,3 L3,3 L3,13 Z M3,21 L11,21 L11,15 L3,15 L3,21 Z M13,21 L21,21 L21,11 L13,11 L13,21 Z M13,3 L13,9 L21,9 L21,3 L13,3 Z</Geometry>
        <Geometry x:Key="StudentsIconGeo">M16,11 C17.66,11 18.99,9.66 18.99,8 C18.99,6.34 17.66,5 16,5 C14.34,5 13,6.34 13,8 C13,9.66 14.34,11 16,11 Z M8,11 C9.66,11 10.99,9.66 10.99,8 C10.99,6.34 9.66,5 8,5 C6.34,5 5,6.34 5,8 C5,9.66 6.34,11 8,11 Z M8,13 C5.67,13 1,14.17 1,16.5 L1,19 L15,19 L15,16.5 C15,14.17 10.33,13 8,13 Z M16,13 C15.71,13 15.38,13.02 15.03,13.05 C16.19,13.89 17,15.02 17,16.5 L17,19 L23,19 L23,16.5 C23,14.17 18.33,13 16,13 Z</Geometry>
        <Geometry x:Key="CoursesIconGeo">M18,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,4 C20,2.9 19.1,2 18,2 Z M6,4 L11,4 L11,12 L8.5,10.5 L6,12 L6,4 Z</Geometry>
        <Geometry x:Key="ReportsIconGeo">M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M14,17 L7,17 L7,15 L14,15 L14,17 Z M17,13 L7,13 L7,11 L17,11 L17,13 Z M17,9 L7,9 L7,7 L17,7 L17,9 Z</Geometry>
        <Geometry x:Key="SettingsIconGeo">M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.73,8.87 C2.61,9.08 2.65,9.34 2.85,9.48 L4.88,11.06 C4.83,11.36 4.79,11.69 4.79,12 C4.79,12.31 4.81,12.64 4.86,12.94 L2.83,14.52 C2.65,14.66 2.6,14.93 2.71,15.13 L4.63,18.45 C4.75,18.67 5,18.74 5.22,18.67 L7.61,17.71 C8.11,18.09 8.64,18.41 9.23,18.65 L9.59,21.19 C9.64,21.43 9.83,21.6 10.07,21.6 L13.91,21.6 C14.15,21.6 14.35,21.43 14.38,21.19 L14.74,18.65 C15.33,18.41 15.87,18.09 16.36,17.71 L18.75,18.67 C18.97,18.75 19.22,18.67 19.34,18.45 L21.26,15.13 C21.38,14.91 21.33,14.66 21.13,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z</Geometry>
        <Geometry x:Key="SearchIconGeo">M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z</Geometry>
        <Geometry x:Key="BellIconGeo">M12,22 C13.1,22 14,21.1 14,20 L10,20 C10,21.1 10.89,22 12,22 Z M18,16 L18,11 C18,7.93 16.36,5.36 13.5,4.68 L13.5,4 C13.5,3.17 12.83,2.5 12,2.5 C11.17,2.5 10.5,3.17 10.5,4 L10.5,4.68 C7.63,5.36 6,7.92 6,11 L6,16 L4,18 L4,19 L20,19 L20,18 L18,16 Z</Geometry>
        <Geometry x:Key="EditIconGeo">M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z</Geometry>
        <Geometry x:Key="TrashIconGeo">M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z</Geometry>
        <Geometry x:Key="AddIconGeo">M19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 L11,5 L13,5 L13,11 L19,11 L19,13 Z</Geometry>
        <Geometry x:Key="BuildingIconGeo">M12,3 L2,12 L5,12 L5,20 L11,20 L11,14 L13,14 L13,20 L19,20 L19,12 L22,12 L12,3 Z</Geometry>
        <Geometry x:Key="TeacherIconGeo">M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z</Geometry>
        <Geometry x:Key="WarningIconGeo">M1,21 L23,21 L12,2 L1,21 Z M13,18 L11,18 L11,16 L13,16 L13,18 Z M13,14 L11,14 L11,10 L13,10 L13,14 Z</Geometry>
        <Geometry x:Key="CloseIconGeo">M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 L19,6.41 Z</Geometry>
        <Geometry x:Key="SaveIconGeo">M17,3 L5,3 C3.89,3 3,3.9 3,5 L3,19 C3,20.1 3.89,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,7 L17,3 Z M12,19 C10.34,19 9,17.66 9,16 C9,14.34 10.34,13 12,13 C13.66,13 15,14.34 15,16 C15,17.66 13.66,19 12,19 Z M15,9 L5,9 L5,5 L15,5 L15,9 Z</Geometry>
        <Geometry x:Key="ResetIconGeo">M12,5 L12,1 L7,6 L12,11 L12,7 C15.31,7 18,9.69 18,13 C18,16.31 15.31,19 12,19 C8.69,19 6,16.31 6,13 L4,13 C4,17.42 7.58,21 12,21 C16.42,21 20,17.42 20,13 C20,8.58 16.42,5 12,5 Z</Geometry>
        <Geometry x:Key="MoonIconGeo">M12.3,2 A10,10 0 0,0 12.11,16 A9.92,9.92 0 0,0 20.01,20 A10,10 0 1,1 12.3,2 Z</Geometry>

        <!-- Base Button Template -->
        <Style x:Key="ActionButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Action Button (for Edit/Delete in DataGrid) -->
        <Style x:Key="RoundActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle" Background="{TemplateBinding Background}" 
                                CornerRadius="16" Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Grid Background="{Binding ThemeBackground}">
        <Grid.ColumnDefinitions>
            <!-- Sidebar Column -->
            <ColumnDefinition Width="260"/>
            <!-- Main Content Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- SIDEBAR NAVIGATION (Level 3 - Rich UI SISMA)             -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="{Binding ThemeSidebar}" BorderBrush="{Binding ThemeBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu Navigation -->
                    <RowDefinition Height="*"/>
                    <!-- Theme Toggle & Profile -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand / Logo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Graduation Cap Icon Badge -->
                        <Border Background="#2563EB" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                            <Path Data="{StaticResource GradCapIconGeo}" Fill="White" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SISMA" FontSize="20" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}"/>
                            <TextBlock Text="Sistem Informasi Mahasiswa" FontSize="11" Foreground="{Binding ThemeTextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu Items -->
                <StackPanel Grid.Row="1">
                    <!-- Dashboard Nav -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource DashboardIconGeo}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Mahasiswa Nav -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Mahasiswa" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Mahasiswa">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource StudentsIconGeo}" Fill="{Binding ThemeTextSecondary}" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="Mahasiswa" Foreground="{Binding ThemeTextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Mata Kuliah Nav -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="MataKuliah" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="MataKuliah">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource CoursesIconGeo}" Fill="{Binding ThemeTextSecondary}" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="Mata Kuliah" Foreground="{Binding ThemeTextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Laporan Nav -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Laporan" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Laporan">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource ReportsIconGeo}" Fill="{Binding ThemeTextSecondary}" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="Laporan" Foreground="{Binding ThemeTextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Pengaturan Nav -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Pengaturan" Margin="0,0,0,6" Padding="12,10" HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Pengaturan">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource SettingsIconGeo}" Fill="{Binding ThemeTextSecondary}" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" Text="Pengaturan" Foreground="{Binding ThemeTextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Section: Theme Switch & Profile -->
                <StackPanel Grid.Row="2">
                    <!-- Dark Mode Toggle Switch (Matches Image 2 Level 3) -->
                    <Border Background="{Binding ThemeBackground}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="{Binding ThemeBorder}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource MoonIconGeo}" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Dark Mode" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="#334155">
                                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="track" Property="Background" Value="#2563EB"/>
                                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <!-- User Profile Footer -->
                    <Border Background="{Binding ThemeBackground}" CornerRadius="10" Padding="10" BorderBrush="{Binding ThemeBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar circle -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F59E0B" HorizontalAlignment="Left">
                                <TextBlock Text="AD" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="Admin" FontWeight="Bold" FontSize="13" Foreground="{Binding ThemeTextPrimary}"/>
                                <TextBlock Text="admin@kampus.ac.id" FontSize="11" Foreground="{Binding ThemeTextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN CONTENT AREA                                         -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header Bar -->
                <RowDefinition Height="68"/>
                <!-- Page Content Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Background="{Binding ThemeSidebar}" BorderBrush="{Binding ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Title & Breadcrumb -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Spacer / Search Bar -->
                        <ColumnDefinition Width="*"/>
                        <!-- Top Icons & Profile -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Breadcrumb / Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SISMA" FontSize="13" Foreground="{Binding ThemeTextSecondary}" Margin="0,0,6,0"/>
                        <TextBlock Text="/" FontSize="13" Foreground="{Binding ThemeTextSecondary}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentView}" FontSize="14" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}"/>

                        <!-- DB Status Indicator Badge -->
                        <Border Background="#064E3B" CornerRadius="12" Padding="8,4" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DatabaseStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Search Input in Header -->
                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="{Binding ThemeInputBackground}" CornerRadius="8" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Width="280" Height="38" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource SearchIconGeo}" Fill="{Binding ThemeTextSecondary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" 
                                     FontSize="13" Foreground="{Binding ThemeTextPrimary}" Padding="0,0,8,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Cari mahasiswa atau NIM..." Foreground="#64748B" FontSize="13"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Top Right Action Icons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Notification Bell Button -->
                        <Button Style="{StaticResource RoundActionButton}" Background="{Binding ThemeInputBackground}" Margin="0,0,12,0" ToolTip="Notifikasi">
                            <Grid>
                                <Path Data="{StaticResource BellIconGeo}" Fill="{Binding ThemeTextPrimary}" Width="16" Height="16" Stretch="Uniform"/>
                                <Ellipse Width="7" Height="7" Fill="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                            </Grid>
                        </Button>

                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource RoundActionButton}" Background="{Binding ThemeInputBackground}" Margin="0,0,12,0" ToolTip="Muat Ulang Data">
                            <Path Data="{StaticResource ResetIconGeo}" Fill="{Binding ThemeTextPrimary}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>

                        <!-- Admin Avatar Mini -->
                        <Border Width="34" Height="34" CornerRadius="17" Background="#2563EB" VerticalAlignment="Center">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================================================== -->
            <!-- BODY VIEWS                                           -->
            <!-- ==================================================== -->
            <Grid Grid.Row="1" Margin="24,20,24,20">

                <!-- 1. DASHBOARD VIEW (Level 3 - Rich UI) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding CurrentView, Converter={StaticResource EqToVis}, ConverterParameter=Dashboard}">
                    <StackPanel>
                        <!-- 4 STAT CARDS ROW (Exact match to Image 2 Level 3) -->
                        <UniformGrid Columns="4" Margin="0,0,0,24">
                            <!-- Card 1: Total Mahasiswa (Blue) -->
                            <Border Background="#1E40AF" CornerRadius="12" Margin="0,0,12,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TotalStudents}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Total Mahasiswa" FontSize="13" Foreground="#BFDBFE" FontWeight="Medium" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#3B82F6" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
                                        <Path Data="{StaticResource StudentsIconGeo}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 2: Program Studi (Teal/Green) -->
                            <Border Background="#065F46" CornerRadius="12" Margin="0,0,12,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TotalPrograms}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Program Studi" FontSize="13" Foreground="#A7F3D0" FontWeight="Medium" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#10B981" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
                                        <Path Data="{StaticResource BuildingIconGeo}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 3: Dosen (Orange) -->
                            <Border Background="#9A3412" CornerRadius="12" Margin="0,0,12,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TotalLecturers}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Dosen" FontSize="13" Foreground="#FED7AA" FontWeight="Medium" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F97316" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
                                        <Path Data="{StaticResource TeacherIconGeo}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 4: Angkatan (Purple) -->
                            <Border Background="#5B21B6" CornerRadius="12" Margin="0,0,0,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding TotalBatches}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Angkatan" FontSize="13" Foreground="#DDD6FE" FontWeight="Medium" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#8B5CF6" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GradCapIconGeo}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- TWO-COLUMN DASHBOARD LAYOUT -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left Column: Data Mahasiswa Quick Table -->
                                <ColumnDefinition Width="*"/>
                                <!-- Right Column: Charts & Activity Log -->
                                <ColumnDefinition Width="380"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: DATA MAHASISWA CARD -->
                            <Border Grid.Column="0" Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="20" Margin="0,0,20,0">
                                <StackPanel>
                                    <!-- Table Top Bar -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Data Mahasiswa" FontSize="18" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" VerticalAlignment="Center"/>

                                        <!-- "+ Tambah" Button (Primary Blue) -->
                                        <Button Grid.Column="2" Command="{Binding OpenAddFormCommand}" Style="{StaticResource ActionButtonBase}" Background="#2563EB" Foreground="White" Padding="14,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource AddIconGeo}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="+ Tambah" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- DataGrid (Matching Level 3 SISMA) -->
                                    <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column" 
                                              RowHeight="42" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{Binding ThemeBorder}">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{Binding Path=DataContext.ThemeDataGridHeader, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Setter Property="Foreground" Value="{Binding Path=DataContext.ThemeTextSecondary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="{Binding Path=DataContext.ThemeBorder, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{Binding Path=DataContext.ThemeTextPrimary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{Binding Path=DataContext.ThemeDataGridRowAlt, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="No" Binding="{Binding RowNumber}" Width="45"/>
                                            <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="95"/>
                                            <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="150"/>
                                            
                                            <!-- Program Studi Column with Colored Badge -->
                                            <DataGridTemplateColumn Header="Program Studi" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1E3A8A" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProgramName}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Aksi Column (Edit & Delete Buttons) -->
                                            <DataGridTemplateColumn Header="Aksi" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- Edit Button (Pencil Icon / Orange circle) -->
                                                            <Button Command="{Binding Path=DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource RoundActionButton}" Background="#F97316" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Edit Data">
                                                                <Path Data="{StaticResource EditIconGeo}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>
                                                            </Button>

                                                            <!-- Delete Button (Trash Icon / Red circle) -->
                                                            <Button Command="{Binding Path=DataContext.PromptDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource RoundActionButton}" Background="#EF4444" Width="28" Height="28" ToolTip="Hapus Data">
                                                                <Path Data="{StaticResource TrashIconGeo}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: CHARTS & AKTIVITAS TERBARU -->
                            <StackPanel Grid.Column="1">
                                <!-- Grafik Mahasiswa Card -->
                                <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Grafik Mahasiswa" FontSize="16" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}"/>
                                        <TextBlock Text="Jumlah Mahasiswa per Program Studi" FontSize="12" Foreground="{Binding ThemeTextSecondary}" Margin="0,2,0,16"/>

                                        <!-- Bar Chart Container -->
                                        <ItemsControl ItemsSource="{Binding ProgramStats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Height="150" VerticalAlignment="Bottom"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Bottom" Margin="4,0">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <!-- Value label above bar -->
                                                            <TextBlock Text="{Binding TotalStudents}" FontSize="12" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <!-- The Bar itself -->
                                                            <Border Width="34" Height="{Binding BarHeight}" CornerRadius="6,6,0,0" Background="{Binding BarColor}"/>
                                                            <!-- Program Code Label below bar -->
                                                            <TextBlock Text="{Binding ProgramCode}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Path=DataContext.ThemeTextSecondary, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Aktivitas Terbaru Card (Exact match to Image 2 Level 3) -->
                                <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Aktivitas Terbaru" FontSize="16" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,14"/>

                                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Padding="0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Activity Badge Circle -->
                                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{Binding BadgeColor}" VerticalAlignment="Center">
                                                                <Ellipse Width="6" Height="6" Fill="White"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Path=DataContext.ThemeTextPrimary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="{Binding Path=DataContext.ThemeTextSecondary, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. MAHASISWA VIEW (Full CRUD Table view - Level 2 expanded) -->
                <Grid Visibility="{Binding CurrentView, Converter={StaticResource EqToVis}, ConverterParameter=Mahasiswa}">
                    <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Header bar -->
                                <RowDefinition Height="Auto"/>
                                <!-- Full DataGrid -->
                                <RowDefinition Height="*"/>
                                <!-- Pagination bar -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Controls -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Data Mahasiswa" FontSize="20" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Border Background="#1E3A8A" CornerRadius="12" Padding="10,4">
                                        <TextBlock Text="{Binding TotalStudents, StringFormat='Total Mahasiswa: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD"/>
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding OpenAddFormCommand}" Style="{StaticResource ActionButtonBase}" Background="#10B981" Foreground="White" Padding="16,8" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource AddIconGeo}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="+ Tambah Mahasiswa" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Full Columns DataGrid -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" 
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" 
                                      RowHeight="44" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{Binding ThemeBorder}">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{Binding Path=DataContext.ThemeDataGridHeader, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="Foreground" Value="{Binding Path=DataContext.ThemeTextSecondary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{Binding Path=DataContext.ThemeBorder, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{Binding Path=DataContext.ThemeTextPrimary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{Binding Path=DataContext.ThemeDataGridRowAlt, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No" Binding="{Binding RowNumber}" Width="45"/>
                                    <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="105"/>
                                    <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="160"/>
                                    
                                    <!-- Program Studi -->
                                    <DataGridTemplateColumn Header="Program Studi" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E3A8A" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgramName}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Tanggal Lahir -->
                                    <DataGridTextColumn Header="Tanggal Lahir" Binding="{Binding FormattedBirthDate}" Width="110"/>
                                    
                                    <!-- Alamat -->
                                    <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="*"/>

                                    <!-- No. Telepon -->
                                    <DataGridTextColumn Header="No. Telepon" Binding="{Binding PhoneNumber}" Width="130"/>

                                    <!-- Aksi -->
                                    <DataGridTemplateColumn Header="Aksi" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Edit Button -->
                                                    <Button Command="{Binding Path=DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RoundActionButton}" Background="#F97316" Width="30" Height="30" Margin="0,0,6,0" ToolTip="Edit Data">
                                                                <Path Data="{StaticResource EditIconGeo}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                                                    </Button>

                                                    <!-- Delete Button -->
                                                    <Button Command="{Binding Path=DataContext.PromptDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RoundActionButton}" Background="#EF4444" Width="30" Height="30" ToolTip="Hapus Data">
                                                                <Path Data="{StaticResource TrashIconGeo}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Pagination Footer (Level 2 match) -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="&lt;" Style="{StaticResource ActionButtonBase}" Background="{Binding ThemeInputBackground}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Foreground="{Binding ThemeTextPrimary}" Width="36" Height="36" Margin="0,0,6,0"/>
                                <Border Background="#2563EB" CornerRadius="6" Width="36" Height="36" Margin="0,0,6,0">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Content="&gt;" Style="{StaticResource ActionButtonBase}" Background="{Binding ThemeInputBackground}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Foreground="{Binding ThemeTextPrimary}" Width="36" Height="36"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. MATA KULIAH VIEW -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentView, Converter={StaticResource EqToVis}, ConverterParameter=MataKuliah}">
                    <StackPanel>
                        <TextBlock Text="Daftar Mata Kuliah" FontSize="20" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,16"/>
                        <UniformGrid Columns="3">
                            <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <Border Background="#1E3A8A" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="TI / SI - 3 SKS" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Pemrograman Berbasis Kerangka Kerja" FontWeight="Bold" FontSize="16" Foreground="{Binding ThemeTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Mempelajari pengembangan aplikasi desktop modern WPF, arsitektur MVVM, dan konektivitas SQL Server." Foreground="{Binding ThemeTextSecondary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <Border Background="#065F46" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="TI - 4 SKS" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Basis Data Lanjut" FontWeight="Bold" FontSize="16" Foreground="{Binding ThemeTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Perancangan skema relasional, SQL Server, Stored Procedures, Triggers, indexing, dan optimasi query." Foreground="{Binding ThemeTextSecondary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border Background="#5B21B6" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="TI / MNJ - 3 SKS" Foreground="#DDD6FE" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Rekayasa Perangkat Lunak" FontWeight="Bold" FontSize="16" Foreground="{Binding ThemeTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Metodologi Agile, arsitektur software bertingkat, clean code, dan integrasi sistem enterprise." Foreground="{Binding ThemeTextSecondary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. LAPORAN VIEW -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentView, Converter={StaticResource EqToVis}, ConverterParameter=Laporan}">
                    <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Laporan Statistik Pendaftaran Mahasiswa" FontSize="20" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="Distribusi data mahasiswa berdasarkan Program Studi sesuai tabel Programs &amp; Students SQL Server" Foreground="{Binding ThemeTextSecondary}" FontSize="13" Margin="0,0,0,20"/>

                            <DataGrid ItemsSource="{Binding ProgramStats}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" RowHeight="44">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kode Program" Binding="{Binding ProgramCode}" Width="140"/>
                                    <DataGridTextColumn Header="Nama Program Studi" Binding="{Binding ProgramName}" Width="*"/>
                                    <DataGridTextColumn Header="Jumlah Mahasiswa" Binding="{Binding TotalStudents}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 5. PENGATURAN VIEW -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentView, Converter={StaticResource EqToVis}, ConverterParameter=Pengaturan}">
                    <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="24" MaxWidth="800" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Konfigurasi Database SQL Server" FontSize="20" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="Aplikasi ini mengintegrasikan SQL Server StudentRegistrationDB (Tabel Programs &amp; Students) sesuai panduan." Foreground="{Binding ThemeTextSecondary}" FontSize="13" Margin="0,0,0,20"/>

                            <TextBlock Text="Connection String SQL Server" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SqlConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeTextPrimary}" 
                                     BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="10" FontSize="13" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Command="{Binding TestConnectionCommand}" Style="{StaticResource ActionButtonBase}" Background="#2563EB" Foreground="White" Padding="16,10" Margin="0,0,12,0">
                                    <TextBlock Text="Uji &amp; Hubungkan SQL Server" FontWeight="Bold"/>
                                </Button>
                                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonBase}" Background="{Binding ThemeInputBackground}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Foreground="{Binding ThemeTextPrimary}" Padding="16,10">
                                    <TextBlock Text="Segarkan Data"/>
                                </Button>
                            </StackPanel>

                            <Border Background="{Binding ThemeInputBackground}" CornerRadius="8" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Status Provider Saat Ini:" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DatabaseStatus}" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="File skrip StudentRegistrationDB.sql lengkap tersedia di root direktori proyek untuk eksekusi di SSMS." Foreground="{Binding ThemeTextSecondary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODALS / DIALOG OVERLAYS                                 -->
        <!-- ======================================================== -->

        <!-- 1. LEVEL 1: FORM MAHASISWA (ADD / EDIT DIALOG) -->
        <Grid Grid.ColumnSpan="2" Background="#90000000" 
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{Binding ThemeCardBackground}" CornerRadius="14" Width="520" 
                    BorderBrush="{Binding ThemeBorder}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="Black" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Form Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}" VerticalAlignment="Center"/>
                        <Button Command="{Binding CloseFormCommand}" Style="{StaticResource RoundActionButton}" Background="Transparent" HorizontalAlignment="Right" Width="28" Height="28">
                            <Path Data="{StaticResource CloseIconGeo}" Fill="{Binding ThemeTextSecondary}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Validation Error Message Alert -->
                    <Border Background="#7F1D1D" CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FormValidationMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FormValidationMessage}" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Field: Nama -->
                    <TextBlock Text="Nama Mahasiswa" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeTextPrimary}" 
                             BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Field: NIM -->
                    <TextBlock Text="NIM" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormNIM, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeTextPrimary}" 
                             BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Field: Program Studi -->
                    <TextBlock Text="Program Studi" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding FormSelectedProgram}" DisplayMemberPath="ProgramName"
                              Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeTextPrimary}" 
                              BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Field: Tanggal Lahir -->
                    <TextBlock Text="Tanggal Lahir" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FormBirthDate, Mode=TwoWay}" Padding="6" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Field: Alamat -->
                    <TextBlock Text="Alamat" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeTextPrimary}" 
                             BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Field: No. Telepon -->
                    <TextBlock Text="No. Telepon" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTextPrimary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormPhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeTextPrimary}" 
                             BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,20"/>

                    <!-- Action Buttons (Simpan, Reset, Batal) -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- Reset Button -->
                            <Button Command="{Binding ResetFormCommand}" Style="{StaticResource ActionButtonBase}" Background="{Binding ThemeInputBackground}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Foreground="{Binding ThemeTextPrimary}" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ResetIconGeo}" Fill="{Binding ThemeTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reset" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Batal Button -->
                            <Button Command="{Binding CloseFormCommand}" Style="{StaticResource ActionButtonBase}" Background="Transparent" Foreground="{Binding ThemeTextSecondary}" Padding="14,8" Margin="0,0,8,0">
                                <TextBlock Text="Batal" FontWeight="SemiBold" FontSize="13"/>
                            </Button>

                            <!-- Simpan Button -->
                            <Button Command="{Binding SaveStudentCommand}" Style="{StaticResource ActionButtonBase}" Background="#2563EB" Foreground="White" Padding="18,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SaveIconGeo}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Simpan" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. LEVEL 2: MODAL KONFIRMASI HAPUS (Exact match to Image 2 Level 2) -->
        <Grid Grid.ColumnSpan="2" Background="#90000000" 
              Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" Width="440" 
                    BorderBrush="{Binding ThemeBorder}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="Black" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Warning Icon & Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#FEF3C7" CornerRadius="8" Width="42" Height="42" Margin="0,0,12,0">
                            <Path Data="{StaticResource WarningIconGeo}" Fill="#D97706" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Konfirmasi Hapus" FontSize="16" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}"/>
                            <TextBlock Text="Tindakan ini tidak dapat dibatalkan" FontSize="12" Foreground="{Binding ThemeTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Confirmation Question -->
                    <TextBlock Text="Apakah Anda yakin ingin menghapus data mahasiswa ini?" FontSize="14" Foreground="{Binding ThemeTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Student Details Pill -->
                    <Border Background="{Binding ThemeInputBackground}" CornerRadius="8" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Padding="12,10" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StudentPendingDelete.NIM}" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="-" Foreground="{Binding ThemeTextSecondary}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StudentPendingDelete.Name}" FontWeight="Bold" Foreground="{Binding ThemeTextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons: [Ya, Hapus] [Batal] (Exact match to Image 2 Level 2) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelDeleteCommand}" Style="{StaticResource ActionButtonBase}" Background="{Binding ThemeInputBackground}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1" Foreground="{Binding ThemeTextPrimary}" Padding="18,8" Margin="0,0,10,0">
                            <TextBlock Text="Batal" FontWeight="SemiBold" FontSize="13"/>
                        </Button>

                        <Button Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource ActionButtonBase}" Background="#DC2626" Foreground="White" Padding="20,8">
                            <TextBlock Text="Ya, Hapus" FontWeight="Bold" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>